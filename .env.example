# Proyecto de Supabase (Settings → API). La llave anon es pública; RLS protege los datos.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para aplicar migraciones y correr los tests de RLS (Settings → Database → Connection string, Session pooler).
# Nunca la uses en código que llegue al navegador.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Token privado de Mercado Pago para crear preferencias y consultar pagos.
MP_ACCESS_TOKEN=
# Llave pública de Mercado Pago para integraciones del navegador.
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Secreto para verificar la firma del webhook de Mercado Pago.
MP_WEBHOOK_SECRET=
# URL pública de la app para retornos y notificaciones.
NEXT_PUBLIC_APP_URL=
# Solo servidor, solo el webhook; nunca NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
