# Proyecto de Supabase (Settings → API). La llave anon es pública; RLS protege los datos.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para aplicar migraciones y correr los tests de RLS (Settings → Database → Connection string, Session pooler).
# Nunca la uses en código que llegue al navegador.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:5432/postgres
